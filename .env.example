VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_IDENTITY_NAME=SEEKER: TD
VITE_SOLANA_IDENTITY_URI=https://github.com/who1900/seeker-td
VITE_WALLET_TIMEOUT_MS=60000

# Copy into a private .env. VITE_* values are PUBLIC in the client bundle.
# Optional HTTPS RPC URL; omit to use the configured cluster's public endpoint.
# Never put a private RPC key or server secret in a VITE_* value.
# VITE_SOLANA_RPC_URL=
# VITE_SOLANA_IDENTITY_ICON=

# Checkout stays unavailable without an approved deployed HTTPS server endpoint.
# VITE_COMMERCE_URL=

# DEVNET test-asset configuration only. Omit all three to disable SKR.
# Test mint must not be described as official mainnet SKR. Match server config.
# VITE_SKR_MINT=
# VITE_SKR_DECIMALS=
# VITE_SKR_CLUSTER=devnet

# Legacy SOL recipient/config keys; unused for wallet-free practice.
# VITE_RECEIVING_WALLET=
# VITE_PAYMENT_WALLET_ADDRESS=
# VITE_PRIZE_POOL_WALLET_ADDRESS=
# VITE_EXTRA_RUN_PRICE_USD=

# Firebase is optional. Omit these for local/offline gameplay.
# Public app configuration is not privileged server authorization.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# SERVER ONLY: privileged credentials and private provider keys stay server-side.
# This example does not deploy a listener, configure Admin credentials or enable payments.
COMMERCE_CLUSTER=devnet
COMMERCE_QUOTE_TTL_MS=300000
# Same six disabled SKU as server/commerce-config.mjs PILOT_CATALOG.
# USD cents are pilot references, not approved live prices or market quotes.
COMMERCE_CATALOG_JSON='[{"id":"runs-1","usdCents":25,"runs":1,"std":0,"enabled":false},{"id":"runs-3","usdCents":65,"runs":3,"std":0,"enabled":false},{"id":"runs-10","usdCents":195,"runs":10,"std":0,"enabled":false},{"id":"std-500","usdCents":99,"runs":0,"std":500,"enabled":false},{"id":"std-1500","usdCents":249,"runs":0,"std":1500,"enabled":false},{"id":"std-4000","usdCents":599,"runs":0,"std":4000,"enabled":false}]'
# No invented FX rate: missing/stale rates disable quotes.
# Currency rates require integer-string numerator/denominator plus timestamp/TTL.
COMMERCE_RATES_JSON={}
# COMMERCE_RPC_URL=
# COMMERCE_GENESIS_HASH=
# COMMERCE_RECIPIENT=
# COMMERCE_SKR_MINT=
# COMMERCE_SKR_DECIMALS=
