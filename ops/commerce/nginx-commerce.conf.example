# TEMPLATE ONLY: dedicated vhost, included from nginx http context.
# Replace commerce.example.invalid only after the owner confirms the domain.
# Obtain TLS via Certbot with separate authorization; paths must exist before nginx -t.
limit_req_zone $binary_remote_addr zone=seeker_td_commerce_rate:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=seeker_td_commerce_conn:1m;

server {
    listen 443 ssl;
    server_name commerce.example.invalid;
    ssl_certificate /etc/letsencrypt/live/commerce.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/commerce.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 4k;
    client_body_timeout 5s;
    client_header_timeout 5s;
    keepalive_timeout 5s;
    reset_timedout_connection on;
    limit_req_status 429;
    limit_conn_status 429;

    # Exact request_uri rejects query strings and encoded/normalized aliases.
    location ~ ^/(commerce/(catalog|quote|receipt)|identity/(challenge|complete))$ {
        if ($request_uri !~ "^/(commerce/(catalog|quote|receipt)|identity/(challenge|complete))$") { return 404; }
        if ($request_method !~ "^(GET|POST|OPTIONS)$") { return 405; }
        if ($http_expect != "") { return 417; }
        if ($http_upgrade != "") { return 400; }
        if ($http_trailer != "") { return 400; }
        if ($http_content_encoding != "") { return 415; }
        limit_req zone=seeker_td_commerce_rate burst=10 nodelay;
        limit_conn seeker_td_commerce_conn 8;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8787;
        proxy_set_header Connection close;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade "";
        proxy_set_header Expect "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_connect_timeout 2s;
        proxy_send_timeout 6s;
        proxy_read_timeout 50s;
        proxy_pass http://127.0.0.1:8787;
    }

    # Readiness is private and deliberately not proxied to the internet.
    location = /ready { return 404; }
    location / { return 404; }
}
