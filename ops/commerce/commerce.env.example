# TEMPLATE ONLY. Install a private copy outside the repository:
# /etc/seeker-td/commerce.env: root-owned 0600; directory root:seeker-td-commerce 0750.
# Do not source credentials from repository files or put private keys inline here.
NODE_ENV=production
METADATA_SERVER_DETECTION=none
COMMERCE_NODE_HOST=127.0.0.1
COMMERCE_NODE_PORT=8787
COMMERCE_NODE_CONCURRENCY=16
COMMERCE_NODE_BODY_MS=5000
COMMERCE_NODE_HEADERS_MS=5000
COMMERCE_NODE_OPERATION_MS=45000
COMMERCE_NODE_SHUTDOWN_MS=55000
COMMERCE_CLUSTER=devnet
# Replace with the existing Firebase project (Spark billing stays unchanged).
COMMERCE_FIREBASE_PROJECT_ID=replace-with-existing-project
# Must match the client's identity origin exactly; Capacitor Android uses this.
COMMERCE_IDENTITY_ORIGIN=https://localhost
# Trusted ADC file provisioned separately: root:seeker-td-commerce, 0640;
# parent directory root:seeker-td-commerce, 0750. Never commit ADC JSON.
GOOGLE_APPLICATION_CREDENTIALS=/etc/seeker-td/credentials/firebase-admin.env
# This private .env file contains service-account JSON; ADC is extension-agnostic.
# No EMULATOR variables, no mainnet, no mock/verifier bypass.
# Catalog remains disabled until explicit devnet SOL/SKR configuration is supplied.
# See server/commerce-env.example and server/commerce-README.md for operator values.
