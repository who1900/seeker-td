# Template only. Copy manually OUTSIDE every Git repository as private.env.
# No shell sourcing, process.env overrides, application imports or secret CLI arguments.
# POSIX: private parent directory 0700, private.env 0600, owned by this operator.
# Windows: protected ACL on parent AND file, owner=current user; allow only that SID and SYSTEM.
DEVNET_ASSETS_ACK=CUSTOM_DEVNET_TEST_TOKEN_ONLY
DEVNET_ASSETS_RPC_URL=https://api.devnet.solana.com
# Four DIFFERENT on-curve public keys of dedicated devnet test identities.
DEVNET_ASSETS_OPERATOR=<dedicated-funded-test-operator-public-key>
DEVNET_ASSETS_MINT=<dedicated-test-mint-public-key>
DEVNET_ASSETS_MERCHANT=<dedicated-test-merchant-public-wallet>
DEVNET_ASSETS_TEST_PAYER=<dedicated-manually-controlled-test-payer-public-wallet>
DEVNET_ASSETS_DECIMALS=6
# 1,000 custom test tokens at 6 decimals; NOT official SKR; max 1,000,000 tokens.
DEVNET_ASSETS_SUPPLY_BASE_UNITS=1000000000
DEVNET_ASSETS_RPC_TIMEOUT_MS=8000
DEVNET_ASSETS_MAX_SETUP_LAMPORTS=50000000
DEVNET_ASSETS_OPERATOR_RESERVE_LAMPORTS=1000000
DEVNET_ASSETS_PAYER_MIN_LAMPORTS=10000000
# Separate merchant system-wallet preparation: default 0.001, maximum 0.01 test SOL.
# Transfer only the deficit to max(this target, zero-data rent), within total spend cap.
DEVNET_ASSETS_MERCHANT_MIN_LAMPORTS=1000000
# Only --execute needs these. Paste existing dedicated 64-byte Solana JSON arrays
# manually into PRIVATE private.env. NEVER paste secrets in this template/repo/CLI/chat.
# Operator is fee payer AND retained pilot mint authority. Mint key only needed on first setup.
DEVNET_ASSETS_OPERATOR_SECRET_JSON=
DEVNET_ASSETS_MINT_SECRET_JSON=
# Test-payer and merchant private keys are deliberately NOT accepted by this tool.
